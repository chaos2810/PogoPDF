{
  "name": "@pogopdf/engine",
  "version": "0.1.0",
  "type": "module",
  "main": "src/engine.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "esbuild src/engine.ts --bundle --platform=node --target=node22 --outfile=dist/engine.cjs --external:sharp --external:@napi-rs/canvas --external:pdfkit --external:jsdom --external:mupdf --external:tesseract.js --define:import.meta.url=__filename",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@pogopdf/contracts": "*",
    "csv-parse": "^7.0.2",
    "dompurify": "^3.4.15",
    "jsdom": "^30.1.0",
    "jszip": "^3.10.2",
    "marked": "^18.0.13",
    "mupdf": "^1.28.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
